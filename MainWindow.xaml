<Window x:Class="OExpert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:ht="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf" 
        xmlns:local="clr-namespace:OExpert"
        xmlns:localUI="clr-namespace:OExpert.UILibraryWPF;assembly=UILibraryWPF"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        Title="OExpert" Height="700" Width="1200" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anchor}" Value="True">
                    <Setter Property="Background" Value="Pink" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Height="23" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Top" Background="Bisque">
            <MenuItem x:Name="mnuFile" Header="File">
                <MenuItem x:Name="mnuOpenFile" Header="Open Rule Network" Click="Button_Click"/>
                <MenuItem x:Name="mnuNew" Header="New" Click="Button_Click"/>
                <MenuItem x:Name="mnuSave" Header="Save" Click="Button_Click"/>
                <MenuItem x:Name="mnuSaveAs" Header="Save As.." Click="Button_Click"/>
                <MenuItem x:Name="mnuExit" Header="Exit.." Click="Button_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuTest" Header="Test">
                <MenuItem x:Name="mnuAutoTests" Header="Auto Test all Paths" Click="Button_Click"/>
                <MenuItem x:Name="mnuResultTest" Header="Test Results" Click="Button_Click"/>
            </MenuItem>
            <MenuItem Header="Run">
                <MenuItem x:Name="mnuRunMix" Header="Run" Click="Button_Click"/>
                <MenuItem x:Name="mnuLastRunResult" Header="Last Run Result" Click="Button_Click"/>
                <MenuItem x:Name="mnuRunResult" Header="Select All" Click="Button_Click"/>
                <MenuItem x:Name="mnuViewResultNotepad" Header="View Results by NotePad" Click="Button_Click"/>
                <MenuItem x:Name="mnuResetRule" Header="Reset Rule Network Values" Click="Button_Click"/>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Button Name="btnOpenFile" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Open a rule file..." Click="Button_Click">
                <Image Source="/Images/open.png" Width="24" Height="24"/>
            </Button>
            <Button Name="btnNew" Margin="30,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="New Rule network" Click="Button_Click">
                <Image Source="/Images/new.png" Width="24" Height="24"/>
            </Button>
            <Button Name="btnSave" Margin="60,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Save to File" Click="Button_Click">
                <Image Source="/Images/save.png" Width="24" Height="24"/>
            </Button>
            <Button Name="btnSaveAs" Margin="90,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Save to File As..." Click="Button_Click">
                <Image Source="/Images/saveAs.png" Width="24" Height="24"/>
            </Button>
            <Label Name="labelFile" Margin="190,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">File:</Label>

            <Button Name="btnRun" Margin="0,2,408,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF3F3C2" ToolTip="Auto Test all path.." Click="Button_Click">
                <Image Source="/Images/run-32.png" Width="24" Height="24"/>
            </Button>
            <Button Name="btnResultTest" Margin="0,2,380,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF3F3C2" ToolTip="View Auto Test Results" Click="Button_Click">
                <Image Source="/Images/report-24.48.png" Width="24" Height="24"></Image>
            </Button>
            <Button Name="btnRunMix" Margin="0,2,332,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFE9F7E9" ToolTip="Run Mix mode.." Click="Button_Click">
                <Image Source="/Images/run.png" Width="24" Height="24"/>
            </Button>
            <Button Name="btnLastRunResult" Margin="0,2,304,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFE9F7E9" ToolTip="Last Run Result.." Click="Button_Click">
                <Image Source="/OExpert;component/Images2/document.png" Width="24" Height="24"></Image>
            </Button>
            <Button Name="btnRunResult" Margin="0,2,276,0" Background="#FFE9F7E9" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Run Results.." Click="Button_Click">
                <Image Source="/OExpert;component/Images/reports.48.png" Width="24" Height="24"></Image>
            </Button>

            <Button Name="btnResult" Margin="0,2,242,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFE9F7E9" ToolTip="View Run Result by Notepad" Click="Button_Click">
                <Image Source="/Images/edit-32.png" Width="24" Height="24"/>
            </Button>

            <Button Name="btnExit" Margin="26,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Exit the application" Click="Button_Click">
                <Image Source="/Images/exit.png" Width="24" Height="24"/>
            </Button>
        </Grid>
        <Grid Grid.Row="2" Margin="0,2,0,0">
            <dockablz:Layout Partition="QuickStart">
                <dragablz:TabablzControl Margin="2" ConsolidateOrphanedItems="True">
                    <dragablz:TabablzControl.InterTabController>
                        <dragablz:InterTabController Partition="QuickStart" />
                    </dragablz:TabablzControl.InterTabController>
                    <TabItem Header="Rule Network">
                        <local:UCRuleNetwork x:Name="ucRuleNetwork" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </TabItem>
                    <TabItem Header="Rule Tree">
                        <local:UCRuleTree x:Name="ucRuleTree" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </TabItem>
                    <TabItem Header="Rule Form">
                        <Grid>
                            <Label Name="labelTotal" Margin="20,2,0,0">#:</Label>
                            <Label Name="labelFind" Margin="440,2,0,0">Find:</Label>
                            <TextBox Name="tbFind" Margin="480,6,0,0" Width="300" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" KeyUp="tbFind_KeyUp"></TextBox>
                            <Button Name="btnFind" Margin="784,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Edit selected Rule" Click="Button_Click">
                                <Image Source="/Images/Search.png" Width="24" Height="24"/>
                            </Button>

                            <Button Name="btnEdit" Margin="0,2,194,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Edit selected Rule" Click="Button_Click">
                                <Image Source="/Images/Edit.png" Width="24" Height="24"/>
                            </Button>
                            <Button Name="btnAdd" Margin="0,2,168,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Add New Rule" Click="Button_Click">
                                <Image Source="/Images/add.png" Width="24" Height="24"/>
                            </Button>
                            <Button Name="btnDelete" Margin="26,2,140,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Delete selected Rule" Click="Button_Click">
                                <Image Source="/Images/cut.png" Width="24" Height="24"/>
                            </Button>
                            <Button Name="btnCopy" Margin="0,2,112,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Copy selected Rules" Click="Button_Click">
                                <Image Source="/Images/Copy.png" Width="24" Height="24"/>
                            </Button>
                            <Button Name="btnPaste" Margin="0,2,84,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Paste Rules" Click="Button_Click">
                                <Image Source="/Images/Paste.png" Width="24" Height="24"/>
                            </Button>

                            <DataGrid Margin="0,32,0,0" Name="dgRule" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseRightButtonDown="dgRule_MouseRightButtonDown"
                                   HorizontalGridLinesBrush="#FFC1AEAE" VerticalGridLinesBrush="#FFC1AEAE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Width="40" Binding="{Binding ID}"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Name" Width="10*" Binding="{Binding Name}"></DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Conditions (Or, operator, Condition, WantValue)" Width="40*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DataGrid x:Name="dgConditions" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="None" ItemsSource="{Binding Conditions}" BorderThickness="0"
                                                          HorizontalGridLinesBrush="#FFF3E6E6" VerticalGridLinesBrush="#FFF3E6E6">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Width="40" Header="Or" IsReadOnly="True" Binding="{Binding Or}"></DataGridTextColumn>
                                                        <DataGridTextColumn Width="50" Header="Operator" IsReadOnly="True" Binding="{Binding Operator}"></DataGridTextColumn>
                                                        <DataGridTextColumn Width="80*" Header="Condition" IsReadOnly="True" Binding="{Binding Condition}"></DataGridTextColumn>
                                                        <DataGridTextColumn Width="20*" Header="Want Value" IsReadOnly="True" Binding="{Binding WantValue}"></DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Conclusion" Width="30*" Binding="{Binding Conclusion}"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Probability" Width="80" Binding="{Binding Probability}"></DataGridTextColumn>
                                    <DataGridTextColumn Header="CalcProb" Width="60" Binding="{Binding CalcProbability}"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Value" Width="60" Binding="{Binding Value}"></DataGridTextColumn>
                                    <!--
                                    <DataGridTextColumn Header="X" Width="30" Binding="{Binding X}"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Y" Width="30" Binding="{Binding Y}"></DataGridTextColumn>
                                -->
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <!--TabItem Header="Run Results">
                        <local:UCResult x:Name="ucResult" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </TabItem>
                    <TabItem Header="Test Results">
                        <local:UCResultTest x:Name="ucResultTest" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </TabItem-->
                </dragablz:TabablzControl>
            </dockablz:Layout>
        </Grid>
    </Grid>
</Window>
