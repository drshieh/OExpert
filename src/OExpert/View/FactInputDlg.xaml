<Window x:Class="OExpert.FactInputDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OExpert"
        mc:Ignorable="d"
        Title="Fact Input Dialog" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- local:XDataTypeConverter x:Key = "aXDataTypeConverter" /-->
        <local:InputFactRuleConverter x:Key="aInputFactRuleConverter"></local:InputFactRuleConverter>
    </Window.Resources>
    <Grid>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,2,2">Please provide Facts and pick a Goal.</Label>
        <Grid x:Name="gridGoal" Margin="4,40,2,2">
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0">Goal:</Label>
            <ComboBox x:Name="cbGoal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,2,0,0" Width="598">
            </ComboBox>
        </Grid>
        <DataGrid Margin="0,70,0,0" Name="dgFact" AutoGenerateColumns="False" CanUserAddRows="False"
                      HorizontalGridLinesBrush="#FFC1AEAE" VerticalGridLinesBrush="#FFC1AEAE">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Idx" Width="40" Binding="{Binding idx}" IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Fact" Width="70*" Binding="{Binding fact}" IsReadOnly="True"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Options" Width="30*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Path=value}" 
                               ItemsSource="{Binding Path=options}" SelectionChanged="Options_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="In Rules" Width="10*" Binding="{Binding Converter={StaticResource aInputFactRuleConverter}}" IsReadOnly="True"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnOk" Content="Go" HorizontalAlignment="Right" Margin="0,4,68,4" VerticalAlignment="Top" Width="60" Click="Button_Click" ToolTip="Run Inference Engine"/>
        <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Right" Margin="0,4,4,4" VerticalAlignment="Top" Width="60" Click="Button_Click" ToolTip="Cancel Run"/>
    </Grid>
</Window>
