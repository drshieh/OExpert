<UserControl x:Class="OExpert.UCRuleInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OExpert"
        mc:Ignorable="d" d:Height="362" d:Width="702" >
    <Grid>
        <Label Margin="56,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="ID:"/>
        <TextBox x:Name="tbID" IsReadOnly="True" Margin="87,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" Text=""/>

        <Label Margin="180,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Name:"/>
        <TextBox x:Name="tbName" IsReadOnly="True" Margin="230,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="300" Text=""/>

        <Button Name="btnGoBack" Margin="550,10,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Navigate the jump,Go Back" Click="Button_Click">
            <Image Source="/Images/ArrowLEFT.png" Width="22" Height="22"/>
        </Button>
        <Button Name="btnGoForward" Margin="580,10,10,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Navigate the jump, Go Next" Click="Button_Click">
            <Image Source="/Images/ArrowRIGHT.png" Width="22" Height="22"/>
        </Button>

        <Label Margin="16,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Conclusion:"/>
        <TextBox x:Name="tbConclusion" Margin="87,40,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="24" Text=""/>

        <Label Margin="16,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Probability:"/>
        <TextBox x:Name="tbProbability" Margin="87,70,0,0" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>
        <Label Margin="200,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="X:"/>
        <TextBox x:Name="tbX" Margin="237,70,0,0" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>
        <Label Margin="306,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Y:"/>
        <TextBox x:Name="tbY" Margin="337,70,0,0" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>

        <Label Margin="440,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Value:"/>
        <TextBox x:Name="tbValue" IsReadOnly="True" Margin="490,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" Text=""/>

        <Button Name="btnEditCondition" Margin="0,103,120,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Edit Selected Condition" Click="Button_Click">
            <Image Source="/Images/edit.png" Width="24" Height="24"/>
        </Button>
        <Button Name="btnAddCondition" Margin="0,103,92,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Add New Condition" Click="Button_Click">
            <Image Source="/Images/add.png" Width="24" Height="24"/>
        </Button>
        <Button Name="btnDeleteCondition" Margin="26,103,64,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Delete selected Condition" Click="Button_Click">
            <Image Source="/Images/cut.png" Width="24" Height="24"/>
        </Button>

        <Grid Margin="4,110,4, 4">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Label Content="Conditions:" Margin="2,0,0,0" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"></Label>
                <DataGrid x:Name="dgConditions" Margin="4,24,4,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                  HorizontalGridLinesBrush="#FFF3E6E6" VerticalGridLinesBrush="#FFF3E6E6" MouseRightButtonUp="dgConditions_MouseRightButtonUp">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Or" Width="30" IsReadOnly="True" Binding="{Binding Or}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Operator" Width="60" IsReadOnly="True" Binding="{Binding Operator}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Condition" Width="40*" IsReadOnly="True" Binding="{Binding Condition}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Want Value" Width="25*" IsReadOnly="True" Binding="{Binding WantValue}"></DataGridTextColumn>
                        <DataGridTemplateColumn Header="Options" Width="30*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Options}" HeadersVisibility="None" BorderThickness="0" HorizontalGridLinesBrush="#FFB6A8A8" VerticalGridLinesBrush="#FFB6A8A8" CanUserAddRows="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding}"></DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Input Value" Width="25*" IsReadOnly="True" Binding="{Binding InputValue}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Eval" Width="10*" IsReadOnly="True" Binding="{Binding EvaluatedValue}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Row="1" VerticalAlignment="Center" Height="2" HorizontalAlignment="Stretch"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Label Content="From Rules: (right click to jump)" Margin="2,0,0,0" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"></Label>
                    <DataGrid x:Name="dgFromRule" Margin="4,24,4,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                               HorizontalGridLinesBrush="#FFF3E6E6" VerticalGridLinesBrush="#FFF3E6E6" MouseRightButtonUp="dgRule_MouseRightButtonUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="40" IsReadOnly="True" Binding="{Binding ID}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Name" Width="40*" IsReadOnly="True" Binding="{Binding Name}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Conclusion" Width="40*" IsReadOnly="True" Binding="{Binding Conclusion}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Width="15*" IsReadOnly="True" Binding="{Binding Value}"></DataGridTextColumn>
                            <DataGridTextColumn Header="CalcP" Width="15*" IsReadOnly="True" Binding="{Binding CalcProbability}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Grid Grid.Column="2">
                    <Label Content="Child Rules: (right click to jump)" Margin="2,0,0,0" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"></Label>
                    <DataGrid x:Name="dgChildRule" Margin="4,24,4,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                               HorizontalGridLinesBrush="#FFF3E6E6" VerticalGridLinesBrush="#FFF3E6E6" MouseRightButtonUp="dgRule_MouseRightButtonUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="40" IsReadOnly="True" Binding="{Binding ID}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Name" Width="40*" IsReadOnly="True" Binding="{Binding Name}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Conclusion" Width="40*" IsReadOnly="True" Binding="{Binding Conclusion}"></DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Width="15*" IsReadOnly="True" Binding="{Binding Value}"></DataGridTextColumn>
                            <DataGridTextColumn Header="CalcP" Width="15*" IsReadOnly="True" Binding="{Binding CalcProbability}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
