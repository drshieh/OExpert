<UserControl x:Class="OExpert.UCRuleNetwork"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localUI="clr-namespace:OExpert.UILibraryWPF;assembly=UILibraryWPF"
        xmlns:local="clr-namespace:OExpert"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1000" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Height="23" HorizontalAlignment="Stretch" Margin="0,0,0,0" x:Name="menuRuleEditor" VerticalAlignment="Top" Background="Bisque">
            <MenuItem x:Name="mnuFile" Header="Print">
                <MenuItem x:Name="PrintRuleNetwork" Header="Print Rule Network" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="PrintRuleNetwork2PDF" Header="Print Rule Network to PDF" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="PrintRuleNetworkData" Header="Print Rule Network Data" Click="mnuRuleNetwork_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuEdit" Header="Edit">
                <MenuItem x:Name="CutRule" Header="Cut" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="Edit" Header="Edit/New Item" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="CopyRule" Header="Copy" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="PasteRule" Header="Paste" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="ShowInf" Header="Show Rule Info" Click="mnuRuleNetwork_Click"/>
            </MenuItem>
            <MenuItem Header="Alignment">
                <MenuItem Header="AlignLeftX" Click="mnuRuleNetwork_Click"/>
                <MenuItem Header="AlignRightX" Click="mnuRuleNetwork_Click"/>
                <Separator></Separator>
                <MenuItem Header="AlignTopX" Click="mnuRuleNetwork_Click"/>
                <MenuItem Header="AlignBottomX" Click="mnuRuleNetwork_Click"/>
                <Separator></Separator>
                <MenuItem Header="AlignCenterX" Click="mnuRuleNetwork_Click"/>
                <MenuItem Header="AlignMiddleX" Click="mnuRuleNetwork_Click"/>
                <Separator></Separator>
                <MenuItem Header="AlignSameWidthX" Click="mnuRuleNetwork_Click"/>
                <MenuItem Header="AlignSameHeightX" Click="mnuRuleNetwork_Click"/>
                <Separator></Separator>
                <MenuItem Header="AlignEvenlyHorizontalX" Click="mnuRuleNetwork_Click"/>
                <MenuItem Header="AlignEvenlyVerticalX" Click="mnuRuleNetwork_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuOperations" Header="Operation">
                <MenuItem x:Name="Run" Header="Run All Path" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="RunMixMode" Header="Run with start rule" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="LastRunResult" Header="Last Run Result" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="SelectAll" Header="Select All" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="Reload" Header="Reload Rules" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="ResetRule" Header="Reset Rule Network Values" Click="mnuRuleNetwork_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuView" Header="View">
                <MenuItem x:Name="ZoomIn" Header="Zoom In" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="ZoomOut" Header="Zoom Out" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="FullView" Header="Full View" Click="mnuRuleNetwork_Click"/>
                <MenuItem x:Name="FitWindow" Header="Fit to Window" Click="mnuRuleNetwork_Click"/>
                <!--MenuItem x:Name="SetZoom" Header="Set Zoom Factor" Click="mnuRuleNetwork_Click"/-->
            </MenuItem>
            <!--MenuItem x:Name="mnuOptions" Header="Options">
                    <MenuItem x:Name="Goto" Header="Goto.." Click="mnuRuleNetwork_Click"/>
                    <MenuItem x:Name="Switch" Header="Engine Switch.." Click="mnuRuleNetwork_Click"/>
                    <MenuItem x:Name="SetRuleRect" Header="Set Rule Display Rect.." Click="mnuRuleNetwork_Click"/>
                </MenuItem-->
        </Menu>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" FlowDirection="LeftToRight" Height="26" Background="#FFF7F4D2" Margin="0">
                <Button Name="ShowInfX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Show Selected Item Info" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/datagrid.png" Height="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ></Image>
                </Button>
                <Button Name="LayoutX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Auto layout rule network" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/Layout-32.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ></Image>
                </Button>
                <Button Name="ZoomInX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Zoom In" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/zoom_in-32.png"></Image>
                </Button>
                <Button Name="ZoomOutX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Zoom Out" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/zoom_out-32.png"></Image>
                </Button>
                <Button Name="FitWindowX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Fit Window" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/Fit.png"></Image>
                </Button>
                <Button Name="FullViewX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Full View" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images2/drag.png"></Image>
                </Button>
                <Button Name="ResetRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Reset rule values" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/restart.png"></Image>
                </Button>
                <Button Name="RunX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Run Test all path.." Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/run-32.png"></Image>
                </Button>
                <Button x:Name="RunMixModeX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Run Mix Mode" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/run.png"></Image>
                </Button>
                <Button Name="LastRunResultX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Last Run Result.." Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images2/document.png"></Image>
                </Button>
                <Button Name="PrintRuleNetworkX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Print the rule network (Graphics)" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images2/Printer.png"></Image>
                </Button>
                <Button Name="PrintRuleNetworkDataX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Print the rule network Data" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images2/android-printer.png"></Image>
                </Button>
            </WrapPanel>
            <!--Label Content="Association: Red: False Goto, Green:True Goto, Blud:Child" Margin="0,0,425,0" FontSize="9" HorizontalAlignment="Right" Width="Auto" Grid.Column="1"/-->
            <Grid Grid.Column="1" Background="#FFF7F4D2">
                <!--
                <Grid Margin="0,0,0,0">
                    <Label Content="Fact Link:" HorizontalAlignment="Left" Margin="0,0,0,0" FontSize="10"/>
                    <Line Margin="54,0,0,0" HorizontalAlignment="Left" Stroke="Green" StrokeThickness="2" X1="0" Y1="4" X2="20" Y2="4" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="80,0,0,0">
                    <Label Content="Rule Link:" HorizontalAlignment="Left" Margin="0,0,0,0" FontSize="10"/>
                    <Line Margin="54,0,0,0" HorizontalAlignment="Left" Stroke="Red" StrokeThickness="2" X1="0" Y1="4" X2="20" Y2="4" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="160,0,0,0">
                    <Label Content="Conclusion Link:" HorizontalAlignment="Left" Margin="0,0,0,0" FontSize="10"/>
                    <Line Margin="84,0,0,0" HorizontalAlignment="Left" Stroke="Blue" StrokeThickness="2" X1="0" Y1="4" X2="20" Y2="4" VerticalAlignment="Center"/>
                </Grid>
                -->
                <StackPanel Orientation="Horizontal">
                    <Button Name="AlignLeft" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Left" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_left.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ></Image>
                    </Button>
                    <Button Name="AlignRight" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Right" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_right.png"></Image>
                    </Button>
                    <Button Name="AlignTop" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Top" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_top.png"></Image>
                    </Button>
                    <Button Name="AlignBottom" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Bottom" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_bottom.png"></Image>
                    </Button>
                    <Button Name="AlignCenter" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Center" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_center.png"></Image>
                    </Button>
                    <Button Name="AlignMiddle" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Align Middle" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_middle.png"></Image>
                    </Button>
                    <Button Name="AlignEvenlyHorizontal" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Horizontal Evenly" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_evenly_horizontal.png"></Image>
                    </Button>
                    <Button Name="AlignEvenlyVertical" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Vertical Evenly" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_evenly_vertical.png"></Image>
                    </Button>
                    <Button Name="AlignSameWidth" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Same Width" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_samewidth.png"></Image>
                    </Button>
                    <Button Name="AlignSameHeight" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Same Height" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/align_sameheight.png"></Image>
                    </Button>
                    <Button Name="Undo" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Undo" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/undo.png"></Image>
                    </Button>
                    <Button Name="Redo" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Redo" Click="mnuRuleNetwork_Click">
                        <Image Source="/OExpert;component/Images/redo.png"></Image>
                    </Button>
                </StackPanel>
                <Label Content="Display:" HorizontalAlignment="Left" Margin="300,0,0,0" FontSize="10"/>
                <ComboBox Margin="346,2,0,0" HorizontalAlignment="Left" Width="20" ToolTip="Display options">
                    <CheckBox x:Name="ckbShowRule" Click="ckbShowRules_Click">Show Rules?</CheckBox>
                    <CheckBox x:Name="ckbShowFact" Click="ckbShowRules_Click">Show Facts?</CheckBox>
                    <CheckBox x:Name="ckbShowConclusion" Click="ckbShowRules_Click">Show Conclusion?</CheckBox>
                    <Separator />
                    <CheckBox x:Name="ckbShowRuleLink" Click="ckbShowRules_Click">Show Rules Links?</CheckBox>
                    <CheckBox x:Name="ckbShowFactLink" Click="ckbShowRules_Click">Show Fact links to Rules?</CheckBox>
                    <CheckBox x:Name="ckbShowConclusionLink" Click="ckbShowRules_Click">Show Conclusion links to Rules?</CheckBox>
                    <Separator />
                    <Button x:Name="btnShowRuleOnly" Width="190" HorizontalContentAlignment="Left" Click="ckbShowRules_Click">Show Rule Only</Button>
                    <Button x:Name="btnShowFactOnly" Width="190" HorizontalContentAlignment="Left" Click="ckbShowRules_Click">Show Fact Only</Button>
                    <Button x:Name="btnShowConclusionOnly" Width="190" HorizontalContentAlignment="Left" Click="ckbShowRules_Click">Show Conclusion Only</Button>
                    <Separator />
                    <Button x:Name="btnShowAll" Width="190" Click="ckbShowRules_Click" HorizontalContentAlignment="Left">Show All</Button>
                    <Button x:Name="btnClearAll" Width="190" Click="ckbShowRules_Click" HorizontalContentAlignment="Left">Clear All</Button>
                </ComboBox>
                <CheckBox x:Name="ckbShowTooltip" Margin="396,6,0,0" Click="ckbShowRules_Click">Show Tooltip</CheckBox>
            </Grid>
            <WrapPanel Grid.Column="2" FlowDirection="LeftToRight" Height="26" Background="#FFF7F4D2" Margin="0">
                <Button Name="EditRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Edit Rule" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/edit-32.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ></Image>
                </Button>
                <Button Name="AddRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Add a New Rule" Click="mnuRuleNetwork_Click">
                    <Image Source="/Images/add.png"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Button>
                <Button Name="CutRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Delete selected Rules" Click="mnuRuleNetwork_Click">
                    <Image Source="/Images/cut.png"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Button>
                <Button Name="CopyRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Copy Selected Rules" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/Copy.png" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ></Image>
                </Button>
                <Button Name="PasteRuleX" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Paste Copied Rules" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/Paste.png"></Image>
                </Button>
                <TextBox Name="tbFind" Margin="4,2,2,0" ToolTip="Search string" Width="90" KeyUp="tbFind_KeyUp"/>
                <Button Name="btnFind" Width="24" Height="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="Find in the Rule network" Click="mnuRuleNetwork_Click">
                    <Image Source="/OExpert;component/Images/Find.png"></Image>
                </Button>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="2">
            <local:UCDrawArea x:Name="ucDrawArea"></local:UCDrawArea>
        </Grid>
    </Grid>
</UserControl>
