<UserControl x:Class="OExpert.UCConclusionInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OExpert"
        mc:Ignorable="d"
        d:Height="450" d:Width="600">
    <Grid>
        <Label Margin="16,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Conclusion:"/>
        <TextBox x:Name="tbConclusion" Margin="87,10,104,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="24" Text=""/>
        
        <Label Margin="16,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Value:"/>
        <TextBox x:Name="tbValue" Margin="87,40,0,0" Width="80" IsReadOnly="True" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>
        <Label Margin="200,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="X:"/>
        <TextBox x:Name="tbX" Margin="237,40,0,0" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>
        <Label Margin="306,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Content="Y:"/>
        <TextBox x:Name="tbY" Margin="337,40,0,0" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Text=""/>
        <Label x:Name="labelRules" Content="Related Rules:" Margin="12,73,0,0" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"></Label>

        <DataGrid Margin="0,103,0,0" Name="dgRuleList" AutoGenerateColumns="False" IsReadOnly="True" MouseRightButtonDown="dgRuleList_MouseRightButtonDown"
                                   HorizontalGridLinesBrush="#FFC1AEAE" VerticalGridLinesBrush="#FFC1AEAE">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="60" Binding="{Binding ID}"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Conditions (Or, oper, cond, want, input, eval)" Width="40*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DataGrid AutoGenerateColumns="False" HeadersVisibility="None" CanUserAddRows="False" ItemsSource="{Binding Conditions}" BorderThickness="0" HorizontalGridLinesBrush="#FFC1AEAE" VerticalGridLinesBrush="#FFC1AEAE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="30" IsReadOnly="True" Binding="{Binding Or}"></DataGridTextColumn>
                                    <DataGridTextColumn Width="50" IsReadOnly="True" Binding="{Binding Operator}"></DataGridTextColumn>
                                    <DataGridTextColumn Width="90*" IsReadOnly="True" Binding="{Binding Condition}"></DataGridTextColumn>
                                    <DataGridTextColumn Width="20*" IsReadOnly="True" Binding="{Binding WantValue}"></DataGridTextColumn>
                                    <DataGridTextColumn Width="10*" IsReadOnly="True" Binding="{Binding InputValue}"></DataGridTextColumn>
                                    <DataGridTextColumn Width="30" IsReadOnly="True" Binding="{Binding EvaluatedValue}"></DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Conclusion" Width="30*" Binding="{Binding Conclusion}"></DataGridTextColumn>
                <DataGridTextColumn Header="Probability" Width="80" Binding="{Binding Probability}"></DataGridTextColumn>
                <DataGridTextColumn Header="X" Width="30" Binding="{Binding X}"></DataGridTextColumn>
                <DataGridTextColumn Header="Y" Width="30" Binding="{Binding Y}"></DataGridTextColumn>
                <DataGridTextColumn Header="Value" Width="10*" IsReadOnly="True" Binding="{Binding Value}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
