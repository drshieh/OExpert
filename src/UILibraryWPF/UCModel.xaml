<UserControl x:Class="Com.DRS.UILibraryWPF.UCModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Com.DRS.UILibraryWPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <local:WDrawingCanvas x:Name="ModelCanvas"
          MouseLeftButtonDown="ModelCanvas_MouseLeftButtonDown" MouseMove="ModelCanvas_MouseMove" 
          MouseLeftButtonUp="ModelCanvas_MouseLeftButtonUp" MouseRightButtonDown="ModelCanvas_MouseRightButtonDown" 
          MouseRightButtonUp="ModelCanvas_MouseRightButtonUp" Focusable="true" KeyUp="ModelCanvas_KeyUp">
        </local:WDrawingCanvas>
    </Grid>
</UserControl>
